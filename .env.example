# Variables utilisées par les fonctions /api (Vercel). En local : `vercel env pull .env.local`.
# Base Neon (fournie automatiquement par l'intégration Neon de Vercel)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Mot de passe du back-office (/admin)
ADMIN_PASSWORD=choisissez-un-mot-de-passe-solide
# Secret de signature des sessions admin (32 caractères minimum) : openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Stockage des images envoyées depuis le back-office (fourni par Vercel Blob)
BLOB_READ_WRITE_TOKEN=
